.pio/
.vscode/
*.bin
# except the EGA BIOS the EGA machines boot with, see data/README.md
!data/fs/ega.bin
tools/bios
compile_commands.json
.cache/

# Disk images in data/ are NOT committed by default: a rescue disk built from retail DOS is
# not redistributable. Once it is rebuilt on FreeDOS (which is freely redistributable), drop
# the exclusion for that one file, eg:  !data/rescue-freedos.img
data/fs/*.img

# images/ is the local test shelf: disk images and software to try in the emulator. None of it is
# committed: it is large (the MS-DOS install is 80MB) and mostly not ours to redistribute.
images/

# python bytecode from the host side tools
__pycache__/

# host tool build (host/Makefile)
host/obj/
host/pctool

# test images and logs (tests/run.sh)
tests/build/
# generated from sdkconfig.defaults by the ESP-IDF build
sdkconfig.esp32dev
sdkconfig.old
dependencies.lock
sdkconfig.esp32old
